{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            a.id, \n            a.project_id, \n            a.message, \n            a.severity, \n            a.dismissed, \n            a.created_at\n        FROM alerts a\n        JOIN projects p ON a.project_id = p.id\n        WHERE a.project_id = $1 AND p.country_id = $2 AND a.dismissed = FALSE\n        ORDER BY a.created_at DESC\n        ",
