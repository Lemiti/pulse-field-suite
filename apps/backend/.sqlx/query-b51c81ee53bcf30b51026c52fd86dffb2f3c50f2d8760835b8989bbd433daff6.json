  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            pp.partner_id,\n            p.name,\n            p.type,\n            p.country_id,\n            pp.contribution_amount\n        FROM project_partners pp\n        JOIN partners p ON pp.partner_id = p.id\n        WHERE pp.project_id = $1\n        ORDER BY p.name ASC\n        ",
