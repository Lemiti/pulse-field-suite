  "query": "\n        SELECT\n            p.id as project_id,\n            p.name as project_name,\n            p.budget_allocated as \"budget_allocated!\",\n            p.budget_spent as \"budget_spent!\"\n        FROM projects p\n        WHERE p.country_id = $1\n        ORDER BY p.name ASC\n        ",
