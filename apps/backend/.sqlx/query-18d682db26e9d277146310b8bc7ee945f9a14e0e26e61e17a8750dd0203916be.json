{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            m.id,\n            m.task_id,\n            t.name as task_name,\n            m.gdrive_file_id,\n            m.gdrive_web_url,\n            m.uploaded_by,\n            u.name as uploaded_by_name,\n            m.created_at\n        FROM media m\n        JOIN tasks t ON m.task_id = t.id\n        JOIN users u ON m.uploaded_by = u.id\n        WHERE m.id = $1\n        ",
