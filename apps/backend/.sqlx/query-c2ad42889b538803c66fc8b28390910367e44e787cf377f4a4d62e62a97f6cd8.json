{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.id,\n            t.project_id,\n            p.name as project_name,\n            t.name as task_name,\n            t.updated_at as \"created_at!\"\n        FROM tasks t\n        JOIN projects p ON t.project_id = p.id\n        WHERE p.country_id = $1 AND t.status = 'ANALYSIS'::task_status\n        ORDER BY t.updated_at DESC\n        ",
