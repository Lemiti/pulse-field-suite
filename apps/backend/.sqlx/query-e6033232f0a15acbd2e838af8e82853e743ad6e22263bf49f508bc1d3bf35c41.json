{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            a.id, \n            a.project_id, \n            p.name as project_name,\n            a.message, \n            a.severity, \n            a.created_at as \"created_at!\"\n        FROM alerts a\n        JOIN projects p ON a.project_id = p.id\n        WHERE p.country_id = $1 AND a.dismissed = FALSE\n        ORDER BY a.created_at DESC\n        ",
