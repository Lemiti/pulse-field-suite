{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.country_id,\n            p.name,\n            p.description,\n            p.budget_allocated,\n            p.budget_spent,\n            p.status as \"status: ProjectStatus\",\n            p.funding_sources,\n            p.focus_area as \"focus_area: ProjectFocusArea\",\n            p.location_metadata,\n            0.0::float8 as \"progress_percentage!\",\n            p.is_template,\n            p.start_date,\n            p.end_date,\n            p.sector_type,\n            p.risks_and_mitigations,\n            p.assumptions,\n            p.outcomes_and_indicators,\n            p.total_income,\n            p.donor_name,\n            p.project_leader_id,\n            COALESCE((SELECT array_agg(user_id) FROM project_members WHERE project_id = p.id), ARRAY[]::uuid[]) as \"member_ids!\"\n        FROM projects p\n        WHERE p.id = $1\n        ",
