{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            t.id,\n            t.project_id,\n            t.phase_id,\n            t.name,\n            t.status as \"status: TaskStatus\",\n            t.assigned_to,\n            u.name as \"assigned_user_name?\",\n            t.start_date,\n            t.end_date,\n            t.created_at,\n            t.updated_at\n        FROM tasks t\n        JOIN projects p ON t.project_id = p.id\n        LEFT JOIN users u ON t.assigned_to = u.id\n        WHERE t.project_id = $1 AND p.country_id = $2\n        ORDER BY t.created_at ASC\n        ",
