  "query": "\n        SELECT u.id, u.name, u.email, u.role as \"role: String\", u.country_id, c.name as country_name,\n               u.phone, u.bio, u.focus_area, u.job_title, u.avatar_url\n        FROM users u\n        JOIN countries c ON u.country_id = c.id\n        WHERE u.id = $1\n        ",
